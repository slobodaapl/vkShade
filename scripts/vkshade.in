#!/bin/sh
set -eu

if [ "${1:-}" = "-v" ]; then
  export VKSHADE_LOG_LEVEL=debug
  shift
fi

case "${1:-}" in
--)
  shift
  ;;
-h | --help)
  echo "usage: vkshade [-v] [--] <command> [args...]"
  exit 0
  ;;
esac

if [ "$#" -lt 1 ]; then
  echo "usage: vkshade [-v] [--] <command> [args...]" >&2
  exit 2
fi

vkshade_wrapped_command=$1
case "$vkshade_wrapped_command" in
*/*) ;;
*)
  if vkshade_resolved_command=$(command -v "$vkshade_wrapped_command"); then
    vkshade_wrapped_command=$vkshade_resolved_command
  fi
  ;;
esac
case "$vkshade_wrapped_command" in
/*) ;;
*) vkshade_wrapped_command=$PWD/$vkshade_wrapped_command ;;
esac
export VKSHADE_WRAPPED_COMMAND="${VKSHADE_WRAPPED_COMMAND:-$vkshade_wrapped_command}"
export VKSHADE_WRAPPED_CWD="${VKSHADE_WRAPPED_CWD:-$PWD}"

VKSHADE_LIB=@VKSHADE_LIB@
VKSHADE_AUDIT_LIB=@VKSHADE_AUDIT_LIB@

if [ ! -r "$VKSHADE_LIB" ]; then
  echo "vkshade: missing library: $VKSHADE_LIB" >&2
  exit 1
fi

export ENABLE_VKSHADE="${ENABLE_VKSHADE:-1}"

case ":${LD_PRELOAD:-}:" in
*":$VKSHADE_LIB:"*) ;;
*) export LD_PRELOAD="$VKSHADE_LIB${LD_PRELOAD:+:$LD_PRELOAD}" ;;
esac

# Enable audit redirection by default on Wayland to catch RTLD_LOCAL clients.
if [ "${VKSHADE_USE_LD_AUDIT:-1}" != "0" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -r "$VKSHADE_AUDIT_LIB" ]; then
  case ":${LD_AUDIT:-}:" in
  *":$VKSHADE_AUDIT_LIB:"*) ;;
  *) export LD_AUDIT="$VKSHADE_AUDIT_LIB${LD_AUDIT:+:$LD_AUDIT}" ;;
  esac
fi

exec "$@"
